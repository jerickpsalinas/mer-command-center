# react-day-picker@8 declares a peer range of date-fns@^2 || ^3, while this
# project is on date-fns@4. The two work together in practice (the installed
# pair builds and runs fine), but npm's strict peer resolution refuses the
# combination and fails `npm install` — which is what breaks the Vercel build,
# since Vercel installs with npm. Accept the resolution npm would otherwise
# reject.
legacy-peer-deps=true
